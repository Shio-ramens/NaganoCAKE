<div class="container py-5">
  <div class="row">

    <div class="col-md-2">
      <table class="table table-bordered">
        <thead>
          <tr>
            <th class="text-center bg-light">ジャンル検索</th>
          </tr>
        </thead>
        <tbody>
          <% @genres.each do |genre| %>
            <tr>
              <td>
                <%= link_to genre.name, items_path(genre_id: genre.id), class: "text-dark text-decoration-none" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="col-md-9 offset-md-1">
      <div class="d-flex align-items-end mb-4">
        <h2 class="me-3 mb-0"><%= @genre ? "#{@genre.name}一覧" : "商品一覧" %></h2>
        <p class="mb-1">(全<%= @items.count %>件)</p>
      </div>

      <div class="row g-4">
        <% @items.each do |item| %>
          <div class="col-md-3">
            <%= link_to item_path(item), class: "text-dark text-decoration-none" do %>
              <% if item.image.attached? %>
                <%= image_tag item.image, size: "200x150", class: "w-100 object-fit-cover border rounded" %>
              <% else %>
                <div class="border bg-light d-flex align-items-center justify-content-center" style="height: 150px;">
                  No Image
                </div>
              <% end %>
              
              <p class="mt-2 mb-1 fw-bold text-truncate">
                <%= item.name %>
              </p>
              <p>
                <%# 税込価格の計算ロジックをモデルに持たせている場合はそれを使う %>
                ¥<%= number_with_delimiter(item.price) %>
              </p>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="d-flex justify-content-center mt-5">
        <%#= paginate @items %>
      </div>

    </div>
  </div>
</div>