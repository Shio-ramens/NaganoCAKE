<div class="container py-5">
  <div class="row">

    <div class="col-md-2">

      <div class="bg-white rounded-4 shadow-sm p-3">

        <h5 class="border-bottom pb-2 mb-3">
          ジャンル検索
        </h5>

        <ul class="list-unstyled mb-0">

          <% @genres.each do |genre| %>
            <li class="mb-2">

              <%= link_to genre.name,
                  items_path(genre_id: genre.id),
                  class: "text-dark text-decoration-none d-block genre-link" %>

            </li>
          <% end %>

        </ul>

      </div>

    </div>

        <div class="col-md-9 offset-md-1">
          <div class="d-flex align-items-end mb-4">
            <h2 class="me-3 mb-0"><%= @genre ? "#{@genre.name}一覧" : "商品一覧" %></h2>
            <p class="mb-1">(全<%= @items.total_count %>件)</p>
          </div>

    <div class="row g-4">

      <% @items.each do |item| %>

        <div class="col-lg-3 col-md-4 col-6">

          <%= link_to item_path(item),
              class: "text-dark text-decoration-none" do %>

            <div class="card h-100 border-0 shadow-sm item-card">

              <% if item.image.attached? %>

                <%= image_tag item.image,
                    class: "card-img-top",
                    style: "height: 220px; object-fit: cover;" %>

              <% else %>

                <div class="bg-light d-flex align-items-center justify-content-center"
                     style="height: 220px;">
                  No Image
                </div>

              <% end %>

              <div class="card-body">

                <p class="fw-bold mb-2 text-truncate">
                  <%= item.name %>
                </p>

                <p class="text-secondary mb-0">
                  ¥<%= number_with_delimiter(item.price) %>
                </p>

              </div>

            </div>

          <% end %>

        </div>

      <% end %>

    </div>

      <div class="d-flex justify-content-center mt-5">
        <%= paginate @items %>
      </div>

    </div>
  </div>
</div>