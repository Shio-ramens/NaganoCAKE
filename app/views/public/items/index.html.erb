<div class="container py-5">

  <div class="row">

    <!-- ジャンル検索 -->
    <div class="col-md-2">

      <table class="table table-bordered">
        <thead>
          <tr>
            <th class="text-center">ジャンル検索</th>
          </tr>
        </thead>

        <tbody>
          <tr>
            <td>ケーキ</td>
          </tr>

          <tr>
            <td>焼き菓子</td>
          </tr>

          <tr>
            <td>プリン</td>
          </tr>

          <tr>
            <td>キャンディ</td>
          </tr>
        </tbody>
      </table>

    </div>

    <!-- 商品一覧 -->
    <div class="col-md-9">

      <div class="d-flex align-items-end mb-4">
        <h2 class="me-3 mb-0">商品一覧</h2>
        <p class="mb-1">(全x件)</p>
      </div>

      <div class="row g-4">

        <% 8.times do %>

          <div class="col-md-3">
            <!-- 仮画像 -->
            <div class="border" style="height: 180px;"></div>
            <p class="mt-2 mb-1 fw-bold">
              商品名
            </p>
            <p>
              ¥0,000
            </p>
          </div>

        <% end %>

      </div>

      <!-- ページネーション -->
      <div class="text-center mt-5">
        <a href="#">1</a>
        <a href="#" class="mx-2">2</a>
        <a href="#">3</a>
        <a href="#" class="ms-2">Next ></a>
        <a href="#" class="ms-2">Last >></a>
      </div>

    </div>

  </div>

</div>