<div class="container py-5">
  <div class="row">

    <div class="col-md-2">
      <table class="table table-bordered">
        <thead>
          <tr>
            <th class="text-center bg-light">ジャンル検索</th>
          </tr>
        </thead>
        <tbody>
          <% @genres.each do |genre| %>
            <tr>
              <td>
                <%= link_to genre.name, items_path(genre_id: genre.id), class: "text-dark text-decoration-none" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="col-md-9 offset-md-1">
      <div class="row">

        <div class="col-md-5">
          <% if @item.image.attached? %>
            <%= image_tag @item.image, size: "400x300", class: "w-100 object-fit-cover border rounded" %>
          <% else %>
            <div class="border bg-light d-flex align-items-center justify-content-center" style="height: 300px;">
              No Image
            </div>
          <% end %>
        </div>

        <div class="col-md-7">
          <h2 class="fw-bold mb-4">
            <%= @item.name %>
          </h2>

          <p class="mb-5 fs-5">
            <%= @item.introduction %>
          </p>

          <h3 class="mb-5 fw-bold">

            ¥<%= number_with_delimiter((@item.price * 1.1).floor) %>
            <span class="fs-6">(税込)</span>
          </h3>

          <%= form_with model: @cart_item, url: cart_items_path, method: :post do |f| %>
            <%= f.hidden_field :item_id, value: @item.id %>
            <div class="d-flex align-items-center">
              <%= f.select :amount, options_for_select((1..99)), { include_blank: '個数選択' }, class: "form-select w-25 me-4" %>
              <%= f.submit "カートに入れる", class: "btn btn-success px-4 py-2" %>
            </div>
          <% end %>
        </div>

      </div>
    </div>

  </div>
</div>