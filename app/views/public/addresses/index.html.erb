<div class="container" style="padding: 20px;">
  <h3 style="background-color: #e9e9e9; display: inline-block; padding: 5px 15px; margin-bottom: 30px;">
    配送先登録／一覧
  </h3>

  <%= form_with model: @address, url: addresses_path, local: true, style: "margin-bottom: 40px; line-height: 2.5;" do |f| %>
    <div style="display: flex; margin-bottom: 10px;">
      <%= f.label :postal_code, "郵便番号(ハイフンなし)", style: "width: 200px;" %>
      <%= f.text_field :postal_code, placeholder: "0000000", style: "width: 200px; padding: 5px;" %>
    </div>
    
    <div style="display: flex; margin-bottom: 10px;">
      <%= f.label :address, "住所", style: "width: 200px;" %>
      <%= f.text_field :address, placeholder: "東京都渋谷区代々木神園町0-0", style: "width: 500px; padding: 5px;" %>
    </div>
    
    <div style="display: flex; margin-bottom: 10px;">
      <%= f.label :name, "宛名", style: "width: 200px;" %>
      <%= f.text_field :name, placeholder: "令和道子", style: "width: 200px; padding: 5px;" %>
      
      <%= f.submit "新規登録", style: "background-color: #5cb85c; color: white; border: none; padding: 5px 20px; border-radius: 4px; margin-left: 20px; cursor: pointer;" %>
    </div>
  <% end %>

  <table border="1" style="border-collapse: collapse; width: 700px; text-align: left;">
    <thead>
      <tr style="background-color: #e9e9e9;">
        <th style="padding: 10px;">郵便番号</th>
        <th style="padding: 10px;">住所</th>
        <th style="padding: 10px;">宛名</th>
        <th style="padding: 10px; width: 180px;"></th>
      </tr>
    </thead>
    <tbody>
      <% @addresses.each do |address| %>
        <tr>
          <td style="padding: 10px;"><%= address.postal_code %></td>
          <td style="padding: 10px;"><%= address.address %></td>
          <td style="padding: 10px;"><%= address.name %></td>
          <td style="padding: 10px; text-align: center;">
            <%= link_to "編集する", edit_address_path(address), class: "btn btn-success", style: "background-color: #5cb85c; color: white; padding: 5px 10px; border-radius: 4px; text-decoration: none; margin-right: 5px;" %>
            <%= button_to "削除する", address_path(address), method: :delete, data: { confirm: "本当に削除しますか？" }, class: "btn btn-danger", style: "background-color: #d9534f; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer;" %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
