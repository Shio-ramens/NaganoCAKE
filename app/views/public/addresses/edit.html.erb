<div class="container" style="padding: 20px;">
  <h2>配送先編集</h2>

  <%= form_with model: @address, url: address_path(@address), method: :patch, local: true do |f| %>
    <div style="margin-bottom: 15px;">
      <%= f.label :postal_code, "郵便番号(ハイフンなし)" %><br>
      <%= f.text_field :postal_code %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :address, "住所" %><br>
      <%= f.text_field :address, style: "width: 100px; max-width: 500px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :name, "宛名" %><br>
      <%= f.text_field :name %>
    </div>

    <%= f.submit "変更を保存", class: "btn btn-success", style: "background-color: #5cb85c; color: white; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer;" %>
  <% end %>

</div>