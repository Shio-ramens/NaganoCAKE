<div class="container py-5">
  <div class="row mb-3 align-items-center">
    <div class="col-8">
      <h4 class="mb-0">
        <span class="bg-light px-3 py-1 rounded-3">ショッピングカート</span>
      </h4>
    </div>
    <div class="col-4 text-end">
      <%= button_to "カートを空にする", destroy_all_cart_items_path, method: :delete, class: "btn btn-danger btn-sm", data: { confirm: "本当にカートを空にしますか？" } %>
    </div>
  </div>

  <table class="table table-bordered align-middle cart-table">
    <thead class="table-light">
      <tr>
        <th style="width: 40%;">商品名</th>
        <th style="width: 15%;">単価(税込)</th>
        <th style="width: 20%;">数量</th>
        <th style="width: 15%;">小計</th>
        <th style="width: 10%;"></th>
      </tr>
    </thead>
    <tbody>
      <% total = 0 %>
      <% @cart_items.each do |cart| %>
        <% subtotal = (cart.item.with_tax_price * cart.amount).floor %>
        <% total += subtotal %>
        <tr>
          <td>
            <%= image_tag cart.item.get_image(60, 40), class: "me-2 border rounded" %>
            <span class="fw-bold"><%= cart.item.name %></span>
          </td>
          <td><%= number_with_delimiter(cart.item.with_tax_price) %></td>
          <td>
            <%= form_with model: cart, url: cart_item_path(cart), method: :patch, class: "d-flex align-items-center" do |f| %>
              <%= f.select :amount, *[1..99], {}, { class: "form-select form-select-sm me-2", style: "width: 70px;" } %>
              <%= f.submit "変更", class: "btn btn-success btn-sm" %>
            <% end %>
          </td>
          <td><%= number_with_delimiter(subtotal) %></td>
          <td class="text-center">
            <%= button_to "削除する", cart_item_path(cart), method: :delete, class: "btn btn-danger btn-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="text-end">
    <p class="fs-5 fw-bold">合計金額: <%= number_with_delimiter(total) %></p>
  </div>

  <div class="row mt-4">
    <div class="col-md-6">
      <%= link_to "買い物を続ける", root_path, class: "btn btn-primary px-4 fw-bold" %>
    </div>
    <div class="col-md-4 offset-md-2">
      <table class="table table-bordered">
        <tr>
          <th class="table-light w-50">合計金額</th>
          <td class="fw-bold"><%= number_with_delimiter(total) %></td>
        </tr>
      </table>
    </div>
  </div>

  <div class="text-center mt-5">
    <% if @cart_items.any? %>
      <%= link_to "情報入力に進む", new_order_path, class: "btn btn-success btn-lg px-5 fw-bold" %>
    <% end %>
  </div>
</div>