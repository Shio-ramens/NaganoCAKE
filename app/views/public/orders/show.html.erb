<div class="container my-5">
  <div class="row mb-4">
    <div class="col-md-3">
      <h3 style="background-color: #e9ecef; display: inline-block; padding: 5px 15px; font-size: 20px;">注文履歴詳細</h3>
    </div>
  </div>

  <div class="row mb-5">
    <div class="col-md-7">
      <h5 class="fw-bold mb-3">注文情報</h5>
      <table class="table table-bordered">
        <tr>
          <th style="background-color: #eee; width: 25%;">注文日</th>
          <td><%= @order.created_at.strftime('%Y/%m/%d') %></td>
        </tr>
        <tr>
          <th style="background-color: #eee;">配送先</th>
          <td>
            〒<%= @order.postal_code %><br>
            <%= @order.address %><br>
            <%= @order.name %>
          </td>
        </tr>
        <tr>
          <th style="background-color: #eee;">支払方法</th>
          <td><%= @order.payment_method_i18n %></td>
        </tr>
        <tr>
          <th style="background-color: #eee;">ステータス</th>
          <td><%= @order.status_i18n %></td>
        </tr>
      </table>
    </div>

    <div class="col-md-5">
      <h5 class="fw-bold mb-3">請求情報</h5>
      <table class="table table-bordered">
        <tr>
          <th style="background-color: #eee; width: 40%;">商品合計</th>
          <%# 請求額から送料を引いて算出 %>
          <td><%= number_with_delimiter(@order.total_payment - @order.shipping_cost) %></td>
        </tr>
        <tr>
          <th style="background-color: #eee;">配送料</th>
          <td><%= number_with_delimiter(@order.shipping_cost) %></td>
        </tr>
        <tr>
          <th style="background-color: #eee;"><strong>ご請求額</strong></th>
          <td class="fw-bold"><%= number_with_delimiter(@order.total_payment) %></td>
        </tr>
      </table>
    </div>
  </div>

  <div class="row">
    <div class="col-md-9">
      <h5 class="fw-bold mb-3">注文内容</h5>
      <table class="table table-bordered">
        <thead>
          <tr style="background-color: #eee;">
            <th style="width: 55%;">商品</th>
            <th style="width: 15%;">単価（税込）</th>
            <th style="width: 15%;">個数</th>
            <th style="width: 15%;">小計</th>
          </tr>
        </thead>
        <tbody>
          <% @order_details.each do |detail| %>
            <tr>
              <td><%= detail.item.name %></td>
              <td><%= number_with_delimiter(detail.price) %></td>
              <td><%= detail.amount %></td>
              <td><%= number_with_delimiter(detail.price * detail.amount) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>