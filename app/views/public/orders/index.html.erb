<div class="container my-5">
  <div class="row mb-4">
    <div class="col-md-3">
      <h3 style="background-color: #e9ecef; display: inline-block; padding: 5px 15px; font-size: 20px;">注文履歴一覧</h3>
    </div>
  </div>

  <table class="table table-bordered align-middle">
    <thead>
      <tr style="background-color: #eee;">
        <th style="width: 12%;">注文日</th>
        <th style="width: 40%;">配送先</th>
        <th style="width: 25%;">注文商品</th>
        <th style="width: 10%;">支払金額</th>
        <th style="width: 10%;">ステータス</th>
        <th style="width: 10%;">注文詳細</th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><%= order.created_at.strftime('%Y/%m/%d') %></td>
          <td>
            〒<%= order.postal_code %><br>
            <%= order.address %><br>
            <%= order.name %>
          </td>
          <td>
            <% order.order_details.each do |detail| %>
              <%= detail.item.name %><br>
            <% end %>
          </td>
          <td><%= number_with_delimiter(order.total_payment) %>円</td>
          <td>
            <%= order.status_i18n %>
          </td>
          <td class="text-center">
            <%# order_path(order) で各注文の詳細ページへ飛ばす %>
            <%= link_to "表示する", order_path(order), class: "btn btn-primary btn-sm px-3 fw-bold" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>