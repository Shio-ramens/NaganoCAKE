<div class="container mt-5"> <div class="row">
    <div class="col-md-10 offset-md-1"> <h2 class="bg-light d-inline-block px-3 py-1 mb-4">注文情報入力</h2>

      <%= form_with model: @order, url: confirm_orders_path, method: :post, data: { turbo: false } do |f| %>

        <h4 class="font-weight-bold">支払方法</h4>
        <div class="ml-4 mb-4">
          <div class="form-check mb-2">
            <%= f.radio_button :payment_method, Order.payment_methods.key(0), class: "form-check-input", checked: true %>
            <%= f.label :payment_method_credit_card, Order.payment_methods_i18n[:credit_card], class: "form-check-label" %>
          </div>
          <div class="form-check">
            <%= f.radio_button :payment_method, Order.payment_methods.key(1), class: "form-check-input" %>
            <%= f.label :payment_method_transfer, Order.payment_methods_i18n[:transfer], class: "form-check-label" %>
          </div>
        </div>

        <h4 class="font-weight-bold mt-4">お届け先</h4>
        <div class="ml-4">
          <div class="form-check mb-3">
            <%= f.radio_button :select_address, "0", class: "form-check-input", checked: true %>
            <%= f.label :select_address_0, "ご自身の住所", class: "form-check-label font-weight-bold" %>
            <div class="ml-4 mt-2">
              〒<%= current_customer.postal_code %> <%= current_customer.address %><br>
              <%= current_customer.last_name %> <%= current_customer.first_name %>
            </div>
          </div>

          <div class="form-check mb-4">
            <%= f.radio_button :select_address, "1", class: "form-check-input" %>
            <%= f.label :select_address_1, "登録済住所から選択", class: "form-check-label font-weight-bold" %>
            <div class="ml-4 mt-2">
              <%= f.select :address_id, options_from_collection_for_select(current_customer.addresses, :id, :address_display), {}, {class: "form-control col-md-8"} %>
            </div>
          </div>

          <div class="form-check mb-3">
            <%= f.radio_button :select_address, "2", class: "form-check-input" %>
            <%= f.label :select_address_2, "新しいお届け先", class: "form-check-label font-weight-bold" %>
            
            <div class="ml-4 mt-2">
              <table class="table table-borderless">
                <tr>
                  <td style="width: 30%;"><%= f.label :postal_code, "郵便番号(ハイフンなし)" %></td>
                  <td><%= f.text_field :postal_code, class: "form-control", placeholder: "0000000", style: "width: 300px;" %></td>
                </tr>
                <tr>
                  <td><%= f.label :address, "住所" %></td>
                  <td><%= f.text_field :address, class: "form-control", placeholder: "東京都渋谷区代々木神園町0-0" %></td>
                </tr>
                <tr>
                  <td><%= f.label :name, "宛名" %></td>
                  <td><%= f.text_field :name, class: "form-control", placeholder: "令和道子", style: "width: 300px;" %></td>
                </tr>
              </table>
            </div>
          </div>
        </div>

        <div class="text-center mt-5">
          <%= f.submit "確認画面へ進む", class: "btn btn-primary btn-lg px-5" %>
        </div>

      <% end %>

    </div>
  </div>
</div>