<div class="container py-5">

<h2 class="mb-5">
  <span class="bg-ligh px-3">新規会員登録</span>
</h2>

<%= form_with model: @customer, url: customers_sign_up_path do |f| %>

  <% if @customer.errors.any? %>
    <div style="color:red">
      <% @customer.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="row mb-3 align-items-center">
    <div class="col-md-3">
      <%= f.label :last_name, "名前" %>
    </div>

    <div class="col-md-1">
      (姓)
    </div>

    <div class="col-md-3">
      <%= f.text_field :last_name,
      placeholder: "令和",
      class: "form-control" %>
    </div>

    <div class="col-md-1">
      (名)
    </div>

    <div class="col-md-3">
      <%= f.text_field :first_name,
      placeholder: "道子",
      class: "form-control" %>
    </div>
  </div>

    <div class="row mb-3 align-items-center">
    <div class="col-md-3">
      <%= f.label :last_name, "フリガナ" %>
    </div>

    <div class="col-md-1">
      (セイ)
    </div>

    <div class="col-md-3">
      <%= f.text_field :last_name_kana,
      placeholder: "レイワ",
      class: "form-control" %>
    </div>

    <div class="col-md-1">
      (メイ)
    </div>

    <div class="col-md-3">
      <%= f.text_field :first_name_kana,
      placeholder: "ミチコ",
      class: "form-control" %>
    </div>
  </div>

  <div class="row mb-3 align-items-center">
    <div class="col-md-3">
      <%= f.label :email_address, "メールアドレス" %>
    </div>
    <div class="col-md-1"></div>
    <div class="col-md-3">
      <%= f.email_field :email_address, required: true, placeholder: "sample@example.com", class: "form-control" %>
    </div>
  </div>

  <div class="row mb-3 align-items-center">
    <div class="col-md-3">
      <%= f.label :postal_code, "郵便番号（ハイフンなし）" %>
    </div>
    <div class="col-md-1"></div>
    <div class="col-md-3">
      <%= f.text_field :postal_code, placeholder: "0000000", class: "form-control" %>
    </div>
  </div>

  <div class="row mb-3 align-items-center">
    <div class="col-md-3">
      <%= f.label :address, "住所" %>
    </div>
    <div class="col-md-1"></div>
    <div class="col-md-7">
      <%= f.text_field :address, placeholder: "東京都渋谷区代々木神園町10-0", class: "form-control" %>
    </div>
  </div>

  <div class="row mb-3 align-items-center">
    <div class="col-md-3">
      <%= f.label :telephone_number, "電話番号（ハイフンなし）" %>
    </div>
    <div class="col-md-1"></div>
    <div class="col-md-3">
      <%= f.text_field :telephone_number, placeholder: "0000000000", class: "form-control" %>
    </div>
  </div>

  <div class="row mb-3 align-items-center">
    <div class="col-md-3">
      <%= f.label :password, "パスワード（6文字以上）" %>
    </div>
    <div class="col-md-1"></div>
    <div class="col-md-3">
      <%= f.password_field :password, required: true, class: "form-control" %>
    </div>
  </div>


  <div class="row mb-3 align-items-center">
    <div class="col-md-3">
      <%= f.label :password_confirmation, "パスワード（確認用）" %>
    </div>
    <div class="col-md-1"></div>
    <div class="col-md-3">
      <%= f.password_field :password_confirmation, required: true, class: "form-control" %>
    </div>
  </div>

  <div class="text-center mt-3">
    <%= f.submit "新規登録",
    class: "btn btn-success px-5" %>
  </div>

  <h4 class="mt-5 mb-3">
    <span class="bg-light px-3">既に登録済みの方</span>
  </h4>

  <p class="ms-5" >
    <%= link_to "こちら", new_session_path %>
    からログインしてください。
  </p>

<% end %>