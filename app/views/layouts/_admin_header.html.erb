<div class="shadow-sm">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center py-3">

      <h1 class="h4 m-0 fw-bold d-inline-block border border-2 rounded p-3">
        <%= link_to "ながのCAKE（管理者用）", admin_root_path, class: "text-dark text-decoration-none" %>
      </h1>

      <div class="d-flex align-items-center" style="gap: 15px;">
        <%= link_to '商品一覧', admin_items_path, class: "text-dark text-decoration-none d-inline-block border border-2 rounded p-2 fw-bold bg-white shadow-sm" %>
        <%= link_to '会員一覧', admin_customers_path, class: "text-dark text-decoration-none d-inline-block border border-2 rounded p-2 fw-bold bg-white shadow-sm" %>
        <%= link_to '注文履歴一覧', admin_root_path, class: "text-dark text-decoration-none d-inline-block border border-2 rounded p-2 fw-bold bg-white shadow-sm" %>
        <%= link_to 'ジャンル一覧', admin_genres_path, class: "text-dark text-decoration-none d-inline-block border border-2 rounded p-2 fw-bold bg-white shadow-sm" %>
      </div>

      <div>
        <%= link_to "ログアウト", admin_sign_out_path, 
                    data: { turbo_method: :delete }, 
                    class: "text-dark text-decoration-none d-inline-block border border-2 rounded p-2 text-danger fw-bold" %>
      </div>

    </div>
  </div>
</div>