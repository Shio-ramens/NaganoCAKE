<header class="shadow-sm">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center py-3">

      <!-- ロゴ -->
      <h1 class="h4 m-0 fw-bold d-inline-block border border-2 rounded p-3">
        <%= link_to "ながのCAKE", root_path, class: "text-dark text-decoration-none" %>
      </h1>

      <!-- メニュー -->
      <div>


        <% if authenticated_customer? %>

          <!-- ログイン中 -->
          <%= link_to "マイページ", customers_my_page_path, class: "me-4 text-dark text-decoration-none d-inline-block border border-2 rounded p-2" %>
          <a href="#" class="me-4 text-dark text-decoration-none d-inline-block border border-2 rounded p-2">商品一覧</a>
          <%= link_to "カート", "#",
              class: "me-4 text-dark text-decoration-none d-inline-block border border-2 rounded p-2" %>
          <%= link_to "ログアウト", customers_sign_out_path,
              data: { turbo_method: :delete },
              class: "text-dark text-decoration-none d-inline-block border border-2 rounded p-2" %>

        <% else %>

          <!-- 未ログイン -->
          <%= link_to "About", about_path, class: "me-4 text-dark text-decoration-none d-inline-block border border-2 rounded p-2" %>
          <a href="#" class="me-4 text-dark text-decoration-none d-inline-block border border-2 rounded p-2">商品一覧</a>
          <%= link_to "新規登録", customers_sign_up_path,
              class: "me-4 text-dark text-decoration-none d-inline-block border border-2 rounded p-2" %>
          <%= link_to "ログイン", customers_sign_in_path,
              class: "text-dark text-decoration-none d-inline-block border border-2 rounded p-2" %>

        <% end %>

      </div>

    </div>
  </div>
</header>