<header class="bg-white border-bottom">
  <div class="container">

    <nav class="navbar navbar-expand-lg py-4">

      <!-- ロゴ -->
      <%= link_to root_path, class: "navbar-brand me-5" do %>
        <%= image_tag "logo.png",
            alt: "ながのCAKE",
            style: "height: 80px;" %>
      <% end %>

      <button class="navbar-toggler"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse justify-content-end"
           id="navbarNav">

        <ul class="navbar-nav align-items-center gap-3">

          <% if cookies.signed[:session_id].present? %>

            <p class="mb-0 me-4 fw-bold text-muted">ようこそ、<%= current_customer.last_name %>さん！</p>
            <li class="nav-item">
              <%= link_to "マイページ",
                  customers_my_page_path,
                  class: "nav-link text-dark" %>
            </li>

            <li class="nav-item">
              <%= link_to "商品一覧",
                  items_path,
                  class: "nav-link text-dark" %>
            </li>

            <li class="nav-item">
              <%= link_to "カート",
                  cart_items_path,
                  class: "btn btn-outline-secondary rounded-pill px-4" %>
            </li>

            <li class="nav-item">
              <%= link_to "ログアウト",
                  customers_sign_out_path,
                  data: { turbo_method: :delete },
                  class: "btn btn-dark rounded-pill px-4" %>
            </li>

          <% else %>

            <li class="nav-item">
              <%= link_to "About",
                  about_path,
                  class: "nav-link text-dark" %>
            </li>

            <li class="nav-item">
              <%= link_to "商品一覧",
                  items_path,
                  class: "nav-link text-dark" %>
            </li>

            <li class="nav-item">
              <%= link_to "新規登録",
                  customers_sign_up_path,
                  class: "btn btn-outline-secondary rounded-pill px-4" %>
            </li>

            <li class="nav-item">
              <%= link_to "ログイン",
                  customers_sign_in_path,
                  class: "btn btn-dark rounded-pill px-4" %>
            </li>

          <% end %>

        </ul>

      </div>

    </nav>

  </div>
</header>