<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">

      <h2 class="mb-5">
        <span class="bg-light px-3">管理者ログイン</span>
      </h2>

      <% if flash[:alert] %>
        <div class="alert alert-danger mb-4 mx-md-5"><%= flash[:alert] %></div>
      <% end %>

      <%= form_with url: admin_sign_in_path, local: true do |f| %>

        <div class="row mb-3 align-items-center justify-content-center">
          <%= f.label :email_address, "メールアドレス", class: "col-sm-3 col-form-label" %>
          <div class="col-sm-7">
            <%= f.email_field :email_address, placeholder: "sample@example.com", class: "form-control", required: true, autofocus: true %>
          </div>
        </div>

        <div class="row mb-4 align-items-center justify-content-center">
          <%= f.label :password, "パスワード", class: "col-sm-3 col-form-label" %>
          <div class="col-sm-7">
            <%= f.password_field :password, class: "form-control", required: true %>
          </div>
        </div>

        <div class="row mb-5 justify-content-center">
          <div class="col-sm-7 offset-sm-3">
            <%= f.submit "ログイン", class: "btn btn-primary px-5 fw-bold" %>
          </div>
        </div>

      <% end %>

    </div>
  </div>
</div>