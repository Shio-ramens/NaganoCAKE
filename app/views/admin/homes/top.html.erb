<div class="container my-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">

      <h4 class="bg-light d-inline-block px-3 py-1 mb-4 text-dark font-weight-bold">
        注文履歴
      </h4>

      <table class="table table-hover table-bordered bg-white shadow-sm">
        <thead class="thead-light">
         <tr>
            <th>購入日時</th>
            <th>購入者</th>
            <th>注文個数</th>
            <th>注文ステータス</th>
         </tr>
        </thead>
          <tbody>
            <% @orders.each do |order| %>
              <tr>
                <td>
                  <%= link_to order.created_at.strftime('%Y/%m/%d %H:%M:%S'), "#", class: "text-primary font-weight-bold" %>
                </td>
                
                <td>
                  <% if order.customer %>
                    <%= order.customer.last_name %> <%= order.customer.first_name %>
                  <% else %>
                    <span class="text-muted">テスト 太郎（顧客データなし）</span>
                  <% end %>
                </td>
                
                <td>
                  <%= order.total_quantity %>
                </td>
                
                <td>
                  <span class="badge badge-secondary p-2">
                    <%= order.status_i18n %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

      <div class="d-flex justify-content-center mt-4">
        <%#= paginate @orders %>
      </div>

    </div>
  </div>
</div>