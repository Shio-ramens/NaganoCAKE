<div class="container my-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      <h4 class="bg-light d-inline-block px-3 py-1 mb-4 font-weight-bold">
        <%= @customer.last_name %><%= @customer.first_name %>さんの注文履歴
      </h4>

      <table class="table table-hover border-bottom">
        <thead class="thead-light">
          <tr>
            <th>購入日時</th>
            <th>注文個数</th>
            <th>注文ステータス</th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr>
              <td>
                <%= link_to admin_order_path(order), class: "text-dark border-bottom border-dark" do %>
                  <%= order.created_at.strftime('%Y/%m/%d %H:%M:%S') %>
                <% end %>
              </td>
              <td>
                <%= order.order_details.sum(:amount) %>
              </td>
              <td><%= order.status_i18n %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <div class="d-flex justify-content-center mt-4">
        <%= paginate @orders %>
      </div>
    </div>
  </div>
</div>