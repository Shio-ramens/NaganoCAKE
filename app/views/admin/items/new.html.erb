<div class="container my-5">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      
      <h4 class="bg-light d-inline-block px-3 py-1 mb-5 text-dark font-weight-bold">
        商品新規登録
      </h4>

      <%= form_with model: @item, url: admin_items_path, local: true do |f| %>
        
        <div class="form-group row mb-4">
          <%= f.label :image, "商品画像", class: "col-sm-3 col-form-label font-weight-bold" %>
          <div class="col-sm-9">
            <%= f.file_field :image, accept: "image/*", class: "form-control-file" %>
          </div>
        </div>

        <div class="form-group row mb-4">
          <%= f.label :name, "商品名", class: "col-sm-3 col-form-label font-weight-bold" %>
          <div class="col-sm-9">
            <%= f.text_field :name, placeholder: "商品名を入力", class: "form-control" %>
          </div>
        </div>

        <div class="form-group row mb-4">
          <%= f.label :introduction, "商品説明", class: "col-sm-3 col-form-label font-weight-bold" %>
          <div class="col-sm-9">
            <%= f.text_area :introduction, rows: 4, placeholder: "ここに説明文を記述します", class: "form-control" %>
          </div>
        </div>

        <div class="form-group row mb-4">
          <%= f.label :genre_id, "ジャンル", class: "col-sm-3 col-form-label font-weight-bold" %>
          <div class="col-sm-6">
            <%= f.collection_select :genre_id, Genre.all, :id, :name, { prompt: "-- 選択してください --" }, { class: "form-control custom-select" } %>
          </div>
        </div>

        <div class="form-group row mb-4">
          <%= f.label :price, "税抜価格", class: "col-sm-3 col-form-label font-weight-bold" %>
          <div class="col-sm-6 d-flex align-items-center">
            <%= f.number_field :price, placeholder: "1000", class: "form-control mr-2" %> 円
          </div>
        </div>

        <div class="form-group row mb-5">
          <label class="col-sm-3 col-form-label font-weight-bold">販売ステータス</label>
          <div class="col-sm-9 d-flex align-items-center">
            <div class="form-check form-check-inline mr-4">
              <%= f.radio_button :is_active, true, checked: true, class: "form-check-input", id: "status_active" %>
              <label class="form-check-label font-weight-bold text-success" for="status_active">販売中</label>
            </div>
            <div class="form-check form-check-inline">
              <%= f.radio_button :is_active, false, class: "form-check-input", id: "status_inactive" %>
              <label class="form-check-label font-weight-bold text-secondary" for="status_inactive">販売停止中</label>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-sm-9 offset-sm-3 text-right">
            <%= f.submit "新規登録", class: "btn btn-success btn-lg px-5 font-weight-bold" %>
          </div>
        </div>

      <% end %>

    </div>
  </div>
</div>