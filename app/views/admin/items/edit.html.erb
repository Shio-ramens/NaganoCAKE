<div class="container my-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      
      <h4 class="bg-light d-inline-block px-3 py-1 mb-5 text-dark font-weight-bold">
        商品編集
      </h4>

      <%= form_with model: [:admin, @item], local: true do |f| %>
        
        <div class="form-group row mb-4">
          <%= f.label :image, "商品画像", class: "col-sm-3 col-form-control-label font-weight-bold" %>
          <div class="col-sm-9">
            <%= f.file_field :image, accept: "image/*", class: "form-control-file" %>
          </div>
        </div>

        <div class="form-group row mb-4">
          <%= f.label :name, "商品名", class: "col-sm-3 col-form-control-label font-weight-bold" %>
          <div class="col-sm-6">
            <%= f.text_field :name, placeholder: "商品名を入力", class: "form-control" %>
          </div>
        </div>

        <div class="form-group row mb-4">
          <%= f.label :introduction, "商品説明", class: "col-sm-3 col-form-control-label font-weight-bold" %>
          <div class="col-sm-6">
            <%= f.text_area :introduction, rows: 5, placeholder: "ここに説明文を記述します", class: "form-control" %>
          </div>
        </div>

        <div class="form-group row mb-4">
          <%= f.label :genre_id, "ジャンル", class: "col-sm-3 col-form-control-label font-weight-bold" %>
          <div class="col-sm-4">
            <%= f.collection_select :genre_id, Genre.all, :id, :name, { include_blank: "-- 選択してください --" }, { class: "form-control custom-select" } %>
          </div>
        </div>

        <div class="form-group row mb-4">
          <%= f.label :price, "税抜価格", class: "col-sm-3 col-form-control-label font-weight-bold" %>
          <div class="col-sm-4 d-flex align-items-center">
            <%= f.number_field :price, placeholder: "1000", class: "form-control mr-2" %> 円
          </div>
        </div>

        <div class="form-group row mb-5">
          <%= f.label :is_active, "販売ステータス", class: "col-sm-3 col-form-control-label font-weight-bold" %>
          <div class="col-sm-9 d-flex align-items-center">
            <div class="custom-control custom-radio custom-control-inline mr-4">
              <%= f.radio_button :is_active, true, class: "custom-control-input", id: "status_active" %>
              <%= f.label :is_active, "販売中", value: true, class: "custom-control-label font-weight-bold text-success", for: "status_active" %>
            </div>
            <div class="custom-control custom-radio custom-control-inline">
              <%= f.radio_button :is_active, false, class: "custom-control-input", id: "status_inactive" %>
              <%= f.label :is_active, "販売停止中", value: false, class: "custom-control-label font-weight-bold text-secondary", for: "status_inactive" %>
            </div>
          </div>
        </div>

        <div class="form-group row">
          <div class="col-sm-9 offset-sm-3">
            <%= f.submit "変更を保存", class: "btn btn-success btn-lg px-5 font-weight-bold shadow-sm" %>
          </div>
        </div>

      <% end %>

    </div>
  </div>
</div>