<div class="container py-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      
      <h4 class="mb-5">
        <span class="bg-light px-3">ジャンル編集</span>
      </h4>

      <%= form_with model: [:admin, @genre], local: true do |f| %>
        <div class="row align-items-center">
          <label class="col-sm-2 fw-bold">ジャンル名</label>
          <div class="col-sm-4">
            <%= f.text_field :name, class: "form-control" %>
          </div>
          <div class="col-sm-3">
            <%= f.submit "変更を保存", class: "btn btn-success px-4 fw-bold" %>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</div>