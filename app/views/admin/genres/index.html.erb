<div class="container py-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      
      <h4 class="mb-5">
        <span class="bg-light px-3">ジャンル一覧・追加</span>
      </h4>

      <%= form_with model: [:admin, @genre], local: true, class: "mb-5" do |f| %>
        <div class="row align-items-center">
          <label class="col-sm-2 fw-bold">ジャンル名</label>
          <div class="col-sm-4">
            <%= f.text_field :name, placeholder: "ジャンル名", class: "form-control" %>
          </div>
          <div class="col-sm-3">
            <%= f.submit "新規登録", class: "btn btn-success px-4 fw-bold" %>
          </div>
        </div>
      <% end %>

      <div class="row">
        <div class="col-md-5">
          <table class="table table-hover">
            <thead class="table-light">
              <tr>
                <th class="ps-4">ジャンル</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @genres.each do |genre| %>
                <tr>
                  <td class="ps-4 align-middle"><%= genre.name %></td>
                  <td class="text-end">
                    <%= link_to "編集する", edit_admin_genre_path(genre), class: "btn btn-success btn-sm px-3 mx-2" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</div>